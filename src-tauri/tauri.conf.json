{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rascals",
  "version": "0.1.1",
  "identifier": "com.rascals.chat",
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Rascals",
        "width": 1280,
        "height": 800,
        "minWidth": 940,
        "minHeight": 600,
        "decorations": false,
        "transparent": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": ["icons/icon.ico"],
    "windows": {
      "wix": null,
      "nsis": null
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://github.com/MinikLover67/Rascals/releases/latest/download/latest.json"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEIwQjQ1NkVEQzhCM0NBMjEKUldRaHlyUEk3VmEwc0xOVm9HOHN0dzA5UjV3OVZMRnVqS0FuYUtxT1VLbWVOYnZSSzFTKzYyS3gK",
      "dialog": false
    }
  }
}
