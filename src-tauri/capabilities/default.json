{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Rascals default capability set for the main window.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-set-focus",
    "core:tray:default",
    "autostart:default",
    "notification:default",
    "opener:default",
    "updater:default",
    "process:default"
  ]
}
